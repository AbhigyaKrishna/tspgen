<% const d = it.decl; const sup = d.implements.length ? " : " + d.implements.map((f) => it.h.ref(f, it.qualified)).join(", ") : ""; %>
<%~ it.h.kdoc(d.docs) %><%~ it.h.annotations(d.annotations) %>@Serializable
<% if (d.serialName !== undefined) { %>@SerialName(<%~ it.h.str(d.serialName) %>)
<% } %><% if (d.properties.length === 0) { %>class <%= d.name %><%= sup %>
<% } else { %>data class <%= d.name %>(
<% for (const p of d.properties) { %><%~ it.h.kdoc(p.docs, "    ") %><%~ it.h.annotations(p.annotations, "    ") %><% if (p.serialName !== undefined) { %>    @SerialName(<%~ it.h.str(p.serialName) %>)
<% } %>    <%= p.override ? "override " : "" %>val <%= p.name %>: <%= p.type.text %><%= p.default !== undefined ? " = " + p.default : "" %>,
<% } %>)<%= sup %><%~ it.h.initBlock(d.checks) %>
<% } %>