// Contract for generated code: union types implement unionInfo and MarshalJSON with value
// receivers and carry an `Unknown json.RawMessage` field when info.Unknown is set. Tagged variant
// models implement unionTags with a value receiver; Values[0] is the value written.

// unionTag is a discriminator a variant model writes first and checks when decoding.
type unionTag struct {
	Property string
	Values   []string
}

// unionVariant describes one field of a generated union struct.
type unionVariant struct {
	Field   string
	Values  []string // discriminator values; empty for untagged unions
	Kind    string   // untagged dispatch by first JSON byte: { [ " 0 t, or * for any
	Literal string   // JSON text a literal variant must equal
	Shape   string
	Text    int      // parameter text rank by TypeSpec scalar: 1 exact Members, 2 boolean, 3 integer, 4 float/decimal, 5 other non-string Go type, 6 string; 0 none
	Members []string // exact texts for rank 1
}

type unionInfo struct {
	Name, Property, Envelope, EnvelopeProperty string
	Variants                                   []unionVariant
	Unknown                                    bool
}

type jsonUnion interface{ unionInfo() *unionInfo }

type taggedModel interface{ unionTags() []unionTag }

func asUnion(value reflect.Value) (*unionInfo, bool) {
	if value.Kind() != reflect.Struct || !value.CanInterface() {
		return nil, false
	}
	union, ok := value.Interface().(jsonUnion)
	if !ok && value.CanAddr() {
		union, ok = value.Addr().Interface().(jsonUnion)
	}
	if !ok {
		return nil, false
	}
	return union.unionInfo(), true
}

// requiredPresent reports whether fields carries every required property of a struct candidate (top-level only).
func requiredPresent(value reflect.Value, fields map[string]json.RawMessage) bool {
	value = dereference(value)
	if value.Kind() != reflect.Struct {
		return true
	}
	if _, ok := asUnion(value); ok {
		return true
	}
	if fields == nil {
		return true
	}
	for i := 0; i < value.NumField(); i++ {
		field := value.Type().Field(i)
		if field.PkgPath != "" || !strings.HasPrefix(field.Tag.Get("tsp"), "required,") {
			continue
		}
		if _, ok := fields[strings.Split(field.Tag.Get("json"), ",")[0]]; !ok {
			return false
		}
	}
	return true
}

func containsString(values []string, value string) bool {
	for _, candidate := range values {
		if candidate == value {
			return true
		}
	}
	return false
}

func jsonKind(raw []byte) string {
	if len(raw) == 0 {
		return ""
	}
	switch raw[0] {
	case '{', '[', '"', 'n':
		return string(raw[:1])
	case 't', 'f':
		return "t"
	}
	return "0"
}

func decodeNumbers(data []byte, target any, strict bool) error {
	decoder := json.NewDecoder(bytes.NewReader(data))
	decoder.UseNumber()
	if strict {
		decoder.DisallowUnknownFields()
	}
	return decoder.Decode(target)
}

func canonicalJSON(raw []byte) string {
	var value any
	if decodeNumbers(raw, &value, false) != nil {
		return string(raw)
	}
	var out bytes.Buffer
	encoder := json.NewEncoder(&out)
	encoder.SetEscapeHTML(false)
	if encoder.Encode(value) != nil {
		return string(raw)
	}
	return strings.TrimSpace(out.String())
}

func selectedVariant(value reflect.Value, info *unionInfo) (*unionVariant, reflect.Value, error) {
	var selected *unionVariant
	var field reflect.Value
	for i := range info.Variants {
		candidate := value.FieldByName(info.Variants[i].Field)
		if absent(candidate) {
			continue
		}
		if selected != nil {
			return nil, reflect.Value{}, &ValidationError{Field: info.Name, Message: "more than one variant is set"}
		}
		selected, field = &info.Variants[i], candidate
	}
	return selected, field, nil
}

func unknownVariant(value reflect.Value, info *unionInfo, data []byte, reason string) error {
	if !info.Unknown {
		return &ValidationError{Field: info.Name, Message: reason}
	}
	value.FieldByName("Unknown").SetBytes(append([]byte(nil), data...))
	return nil
}

func unmarshalUnion(target jsonUnion, data []byte) error {
	info := target.unionInfo()
	value := reflect.ValueOf(target).Elem()
	value.Set(reflect.Zero(value.Type()))
	data = bytes.TrimSpace(data)
	if bytes.Equal(data, []byte("null")) {
		return nil
	}
	if info.Property != "" {
		return unmarshalDiscriminated(value, info, data)
	}
	kind := jsonKind(data)
	var fields map[string]json.RawMessage
	if kind == "{" {
		_ = json.Unmarshal(data, &fields)
	}
	var canonical string
	for _, variant := range info.Variants {
		if variant.Literal != "" {
			canonical = canonicalJSON(data)
			break
		}
	}
	// Declaration order decides within a pass: exact match, then lenient with required
	// properties, then (only without an Unknown fallback) any variant that decodes.
	for pass := 0; pass < 3; pass++ {
		if pass == 2 && info.Unknown {
			break
		}
		for _, variant := range info.Variants {
			if variant.Kind != "*" && variant.Kind != kind {
				continue
			}
			if variant.Literal != "" && canonical != canonicalJSON([]byte(variant.Literal)) {
				continue
			}
			field := value.FieldByName(variant.Field)
			candidate := reflect.New(field.Type())
			if decodeNumbers(data, candidate.Interface(), pass == 0) != nil {
				continue
			}
			if pass < 2 && !requiredPresent(candidate, fields) {
				continue
			}
			if pass == 0 && fields != nil {
				// Custom codecs do not inherit DisallowUnknownFields.
				if inner := dereference(candidate); inner.Kind() == reflect.Struct {
					if _, nested := asUnion(inner); !nested && checkUnknownKeys(inner, fields) != nil {
						continue
					}
				}
			}
			field.Set(candidate.Elem())
			return nil
		}
	}
	return unknownVariant(value, info, data, "matches no variant")
}

func unmarshalDiscriminated(value reflect.Value, info *unionInfo, data []byte) error {
	var fields map[string]json.RawMessage
	if err := json.Unmarshal(data, &fields); err != nil || fields == nil {
		return unknownVariant(value, info, data, "must be an object")
	}
	var tag string
	raw, ok := lookupField(fields, info.Property)
	if !ok {
		return unknownVariant(value, info, data, fmt.Sprintf("missing discriminator %q", info.Property))
	}
	if json.Unmarshal(raw, &tag) != nil {
		return unknownVariant(value, info, data, fmt.Sprintf("discriminator %q must be a string", info.Property))
	}
	for _, variant := range info.Variants {
		if !containsString(variant.Values, tag) {
			continue
		}
		payload := []byte(data)
		if info.Envelope == "object" {
			envelope, ok := lookupField(fields, info.EnvelopeProperty)
			if !ok {
				return &ValidationError{Field: info.EnvelopeProperty, Message: "required property is missing"}
			}
			payload = envelope
		}
		field := value.FieldByName(variant.Field)
		candidate := reflect.New(field.Type())
		if err := decodeNumbers(payload, candidate.Interface(), false); err != nil {
			return err
		}
		field.Set(candidate.Elem())
		return nil
	}
	return unknownVariant(value, info, data, fmt.Sprintf("unknown discriminator %q", tag))
}

func marshalUnion(input jsonUnion) ([]byte, error) {
	info := input.unionInfo()
	value := dereference(reflect.ValueOf(input))
	variant, field, err := selectedVariant(value, info)
	if err != nil {
		return nil, err
	}
	if variant == nil {
		if info.Unknown {
			if unknown := value.FieldByName("Unknown").Bytes(); len(unknown) > 0 {
				return unknown, nil
			}
		}
		return nil, &ValidationError{Field: info.Name, Message: "no variant is set"}
	}
	payload, err := json.Marshal(field.Interface())
	if err != nil || info.Envelope != "object" {
		return payload, err
	}
	tag, err := json.Marshal(variant.Values[0])
	if err != nil {
		return nil, err
	}
	return json.Marshal(map[string]json.RawMessage{info.Property: tag, info.EnvelopeProperty: payload})
}

func validateUnion(input jsonUnion) error {
	info := input.unionInfo()
	value := dereference(reflect.ValueOf(input))
	if absent(value) {
		return &ValidationError{Field: info.Name, Message: "must not be null"}
	}
	variant, field, err := selectedVariant(value, info)
	if err != nil {
		return err
	}
	if variant == nil {
		return &ValidationError{Field: info.Name, Message: "no known variant is set"}
	}
	if variant.Literal != "" {
		raw, err := json.Marshal(field.Interface())
		if err != nil {
			return err
		}
		if canonicalJSON(raw) != canonicalJSON([]byte(variant.Literal)) {
			return &ValidationError{Field: info.Name, Message: "does not match the declared literal"}
		}
	}
	return nil
}

func marshalTagged(value any, tags []unionTag) ([]byte, error) {
	raw, err := json.Marshal(value)
	if err != nil || len(tags) == 0 || len(raw) == 0 || raw[0] != '{' {
		return raw, err
	}
	var out bytes.Buffer
	out.WriteByte('{')
	for i, tag := range tags {
		if i > 0 {
			out.WriteByte(',')
		}
		name, _ := json.Marshal(tag.Property)
		text, _ := json.Marshal(tag.Values[0])
		out.Write(name)
		out.WriteByte(':')
		out.Write(text)
	}
	rest := bytes.TrimSpace(raw[1:])
	if len(rest) > 0 && rest[0] != '}' {
		out.WriteByte(',')
	}
	out.Write(rest)
	return out.Bytes(), nil
}

// lookupField finds a JSON property by exact name, then case-insensitively.
func lookupField(fields map[string]json.RawMessage, name string) (json.RawMessage, bool) {
	if raw, ok := fields[name]; ok {
		return raw, true
	}
	for key, raw := range fields {
		if strings.EqualFold(key, name) {
			return raw, true
		}
	}
	return nil, false
}

func unmarshalTagged(data []byte, target any, tags []unionTag) error {
	var fields map[string]json.RawMessage
	if err := json.Unmarshal(data, &fields); err != nil {
		return err
	}
	if fields == nil {
		return nil
	}
	for _, tag := range tags {
		raw, ok := lookupField(fields, tag.Property)
		if !ok {
			continue
		}
		var value string
		if err := json.Unmarshal(raw, &value); err != nil || !containsString(tag.Values, value) {
			return &ValidationError{Field: tag.Property, Message: fmt.Sprintf("must be %q", tag.Values[0])}
		}
	}
	return decodeNumbers(data, target, false)
}

// unionPayload unwraps an object envelope; fields is nil when there is none.
func unionPayload(info *unionInfo, raw json.RawMessage, strict bool) (json.RawMessage, map[string]json.RawMessage, error) {
	if info.Envelope != "object" || len(raw) == 0 || raw[0] != '{' {
		return raw, nil, nil
	}
	var fields map[string]json.RawMessage
	if err := json.Unmarshal(raw, &fields); err != nil {
		return nil, nil, err
	}
	if strict {
		for name := range fields {
			if !strings.EqualFold(name, info.Property) && !strings.EqualFold(name, info.EnvelopeProperty) {
				return nil, nil, &ValidationError{Field: name, Message: "unknown property"}
			}
		}
	}
	payload, _ := lookupField(fields, info.EnvelopeProperty)
	return bytes.TrimSpace(payload), fields, nil
}

func applyUnion(value reflect.Value, info *unionInfo, raw json.RawMessage, strict, validate, defaults bool) error {
	variant, field, err := selectedVariant(value, info)
	if err != nil || variant == nil {
		return err
	}
	payload, _, err := unionPayload(info, raw, strict)
	if err != nil {
		return err
	}
	if validate && len(payload) > 0 {
		if err := checkJSONShape(info.Name, variant.Shape, payload); err != nil {
			return err
		}
	}
	return applyJSON(field, payload, strict, validate, defaults, variant.Shape)
}

func encodeUnion(value reflect.Value, info *unionInfo, raw json.RawMessage, encodeDefaults, explicitNulls bool) (json.RawMessage, error) {
	variant, field, err := selectedVariant(value, info)
	if err != nil || variant == nil {
		return raw, err
	}
	payload, fields, err := unionPayload(info, raw, false)
	if err != nil {
		return nil, err
	}
	encoded, err := encodeValue(field, payload, encodeDefaults, explicitNulls)
	if err != nil || fields == nil {
		return encoded, err
	}
	fields[info.EnvelopeProperty] = encoded
	return json.Marshal(fields)
}

// checkUnknownKeys enforces ignore-unknown-keys=false where custom codecs bypass DisallowUnknownFields.
// Structs with additional properties accept every key.
func checkUnknownKeys(value reflect.Value, fields map[string]json.RawMessage) error {
	if additionalField(value.Type()) >= 0 {
		return nil
	}
	known := map[string]bool{}
	for i := 0; i < value.NumField(); i++ {
		field := value.Type().Field(i)
		if field.PkgPath == "" && field.Tag.Get("tsp") != "" {
			known[strings.Split(field.Tag.Get("json"), ",")[0]] = true
		}
	}
	for _, tag := range modelTags(value) {
		known[tag.Property] = true
	}
	if len(known) == 0 {
		return nil
	}
	for name := range fields {
		if known[name] {
			continue
		}
		matched := false
		for candidate := range known {
			if strings.EqualFold(candidate, name) {
				matched = true
				break
			}
		}
		if !matched {
			return &ValidationError{Field: name, Message: "unknown property"}
		}
	}
	return nil
}

// unmarshalUnionText sets the most specific variant that parses raw: exact members, bool, integer, float, other, string.
func unmarshalUnionText(target jsonUnion, raw string) error {
	info := target.unionInfo()
	value := reflect.ValueOf(target).Elem()
	value.Set(reflect.Zero(value.Type()))
	for rank := 1; rank <= 6; rank++ {
		for _, variant := range info.Variants {
			if variant.Text != rank || (rank == 1 && !containsString(variant.Members, raw)) || !exactText(rank, raw) {
				continue
			}
			field := value.FieldByName(variant.Field)
			candidate := reflect.New(field.Type())
			if DecodeParameter(raw, candidate.Interface()) != nil {
				continue
			}
			field.Set(candidate.Elem())
			return nil
		}
	}
	quoted, _ := json.Marshal(raw)
	return unknownVariant(value, info, quoted, "matches no variant")
}

// exactText reports whether raw is the exact text form of ranks 2-4: no padding, a JSON number, integral for rank 3.
func exactText(rank int, raw string) bool {
	switch rank {
	case 2:
		return raw == "true" || raw == "false"
	case 3, 4:
		if raw == "" || (raw[0] != '-' && (raw[0] < '0' || raw[0] > '9')) || strings.TrimSpace(raw) != raw || !json.Valid([]byte(raw)) {
			return false
		}
		return rank == 4 || checkInteger("", []byte(raw)) == nil
	}
	return true
}

// marshalUnionText writes the set variant as parameter text.
func marshalUnionText(input jsonUnion) ([]byte, error) {
	info := input.unionInfo()
	value := dereference(reflect.ValueOf(input))
	variant, field, err := selectedVariant(value, info)
	if err != nil {
		return nil, err
	}
	if variant == nil {
		if info.Unknown {
			// A captured JSON string writes its text; other captured JSON writes itself.
			raw := value.FieldByName("Unknown").Bytes()
			var text string
			if json.Unmarshal(raw, &text) == nil {
				return []byte(text), nil
			}
			if len(raw) > 0 {
				return append([]byte(nil), raw...), nil
			}
		}
		return nil, &ValidationError{Field: info.Name, Message: "no variant is set"}
	}
	text, err := EncodeParameter(field.Interface())
	return []byte(text), err
}
