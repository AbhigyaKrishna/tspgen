import (
	"bytes"
	"encoding"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"math/big"
	"reflect"
	"regexp"
	"strings"
	"unicode/utf8"
)

// ValidationError identifies a value that violates the generated contract.
type ValidationError struct { Field string; Message string }
func (e *ValidationError) Error() string { return e.Field + ": " + e.Message }

type PropertyConstraints struct {
	MinLength, MaxLength, MinItems, MaxItems int
	MinValue, MaxValue, Pattern, Literal string
}

func absent(value reflect.Value) bool {
	if !value.IsValid() { return true }
	switch value.Kind() {
	case reflect.Pointer, reflect.Interface, reflect.Map, reflect.Slice:
		return value.IsNil()
	}
	return false
}

func dereference(value reflect.Value) reflect.Value {
	for value.IsValid() && (value.Kind() == reflect.Pointer || value.Kind() == reflect.Interface) {
		if value.IsNil() { return reflect.Value{} }
		value = value.Elem()
	}
	return value
}

func checkShape(name, shape string, value reflect.Value) error {
	nullable := strings.HasPrefix(shape, "?")
	shape = strings.TrimPrefix(shape, "?")
	value = dereference(value)
	if absent(value) {
		if nullable { return nil }
		return &ValidationError{Field: name, Message: "must not be null"}
	}
	if strings.HasPrefix(shape, "a") && (value.Kind() == reflect.Slice || value.Kind() == reflect.Array) {
		for i := 0; i < value.Len(); i++ {
			if err := checkShape(fmt.Sprintf("%s[%d]", name, i), shape[1:], value.Index(i)); err != nil { return err }
		}
	}
	if strings.HasPrefix(shape, "m") && value.Kind() == reflect.Map {
		iter := value.MapRange()
		for iter.Next() { if err := checkShape(fmt.Sprintf("%s[%v]", name, iter.Key()), shape[1:], iter.Value()); err != nil { return err } }
	}
	return nil
}

// CheckProperty checks one generated property or HTTP parameter.
func CheckProperty(name string, input any, optional bool, shape string, c PropertyConstraints) error {
	value := reflect.ValueOf(input)
	if optional && absent(value) { return nil }
	if err := checkShape(name, shape, value); err != nil { return err }
	value = dereference(value)
	if absent(value) { return nil }
	fail := func(message string) error { return &ValidationError{Field: name, Message: message} }
	if c.Literal != "" {
		raw, err := json.Marshal(value.Interface())
		if err != nil { return err }
		if !bytes.Equal(raw, []byte(c.Literal)) { return fail("does not match the declared literal") }
	}
	if value.Kind() == reflect.String {
		length := utf8.RuneCountInString(value.String())
		if c.MinLength >= 0 && length < c.MinLength { return fail("too short") }
		if c.MaxLength >= 0 && length > c.MaxLength { return fail("too long") }
		if c.Pattern != "" {
			matched, err := regexp.MatchString(c.Pattern, value.String())
			if err != nil { return err }
			if !matched { return fail("does not match the declared pattern") }
		}
	}
	if value.Kind() == reflect.Slice || value.Kind() == reflect.Array || value.Kind() == reflect.Map {
		if c.MinItems >= 0 && value.Len() < c.MinItems { return fail("too few items") }
		if c.MaxItems >= 0 && value.Len() > c.MaxItems { return fail("too many items") }
	}
	for _, bound := range []struct { text string; minimum bool }{{c.MinValue, true}, {c.MaxValue, false}} {
		if bound.text == "" { continue }
		number, ok := new(big.Rat).SetString(fmt.Sprint(value.Interface()))
		if !ok { return fail("invalid number") }
		limit, ok := new(big.Rat).SetString(bound.text)
		if !ok { return fail("invalid numeric constraint") }
		comparison := number.Cmp(limit)
		if (bound.minimum && comparison < 0) || (!bound.minimum && comparison > 0) { return fail("outside the declared numeric bounds") }
	}
	return nil
}

func checkJSONShape(name, shape string, raw json.RawMessage) error {
	raw = bytes.TrimSpace(raw)
	nullable := strings.HasPrefix(shape, "?")
	shape = strings.TrimPrefix(shape, "?")
	if bytes.Equal(raw, []byte("null")) {
		if nullable { return nil }
		return &ValidationError{Field: name, Message: "must not be null"}
	}
	if strings.HasPrefix(shape, "a") {
		var items []json.RawMessage
		if err := json.Unmarshal(raw, &items); err != nil { return err }
		for i, item := range items { if err := checkJSONShape(fmt.Sprintf("%s[%d]", name, i), shape[1:], item); err != nil { return err } }
	}
	if strings.HasPrefix(shape, "m") {
		var items map[string]json.RawMessage
		if err := json.Unmarshal(raw, &items); err != nil { return err }
		for key, item := range items { if err := checkJSONShape(name + "." + key, shape[1:], item); err != nil { return err } }
	}
	return nil
}

// ValidateValue walks generated models, including generic instances and collections.
func ValidateValue(input any) error {
	type visitKey struct { typeOf reflect.Type; address uintptr; length int }
	seen := map[visitKey]bool{}
	var visit func(reflect.Value) error
	visit = func(value reflect.Value) error {
		if absent(value) { return nil }
		if value.Kind() == reflect.Pointer {
			key := visitKey{typeOf: value.Type(), address: value.Pointer()}
			if seen[key] { return nil }
			seen[key] = true
		}
		validated := false
		if value.CanInterface() {
			if validator, ok := value.Interface().(interface { Validate() error }); ok {
				if err := validator.Validate(); err != nil { return err }
				validated = true
			}
		}
		value = dereference(value)
		if absent(value) { return nil }
		if value.Kind() == reflect.Map || value.Kind() == reflect.Slice {
			key := visitKey{typeOf: value.Type(), address: uintptr(value.UnsafePointer()), length: value.Len()}
			if seen[key] { return nil }
			seen[key] = true
		}
		if !validated && value.CanAddr() && value.Addr().CanInterface() {
			if validator, ok := value.Addr().Interface().(interface { Validate() error }); ok { if err := validator.Validate(); err != nil { return err } }
		}
		switch value.Kind() {
		case reflect.Struct:
			for i := 0; i < value.NumField(); i++ { if value.Type().Field(i).PkgPath == "" { if err := visit(value.Field(i)); err != nil { return err } } }
		case reflect.Slice, reflect.Array:
			for i := 0; i < value.Len(); i++ { if err := visit(value.Index(i)); err != nil { return err } }
		case reflect.Map:
			iter := value.MapRange()
			for iter.Next() { if err := visit(iter.Value()); err != nil { return err } }
		}
		return nil
	}
	return visit(reflect.ValueOf(input))
}

func applyJSON(value reflect.Value, raw json.RawMessage, validate, defaults bool) error {
	value = dereference(value)
	if absent(value) { return nil }
	switch value.Kind() {
	case reflect.Struct:
		var fields map[string]json.RawMessage
		if len(raw) > 0 && raw[0] == '{' { if err := json.Unmarshal(raw, &fields); err != nil { return err } }
		for i := 0; i < value.NumField(); i++ {
			field := value.Type().Field(i)
			if field.PkgPath != "" || field.Tag.Get("tsp") == "" { continue }
			name := strings.Split(field.Tag.Get("json"), ",")[0]
			item, present := fields[name]
			fallback := field.Tag.Get("default")
			if !present && defaults && fallback != "" && value.Field(i).CanAddr() {
				if err := json.Unmarshal([]byte(fallback), value.Field(i).Addr().Interface()); err != nil { return err }
				item, present = json.RawMessage(fallback), true
			}
			parts := strings.SplitN(field.Tag.Get("tsp"), ",", 2)
			check := validate && field.Tag.Get("tspvalidate") != "false"
			if check && parts[0] == "required" && !present { return &ValidationError{Field: name, Message: "required property is missing"} }
			if check && present { if err := checkJSONShape(name, parts[1], item); err != nil { return err } }
			if present { if err := applyJSON(value.Field(i), bytes.TrimSpace(item), validate, defaults); err != nil { return err } }
		}
	case reflect.Slice, reflect.Array:
		var items []json.RawMessage
		if len(raw) > 0 && raw[0] != '[' { return nil }
		if len(raw) > 0 { if err := json.Unmarshal(raw, &items); err != nil { return err } }
		for i := 0; i < value.Len() && i < len(items); i++ { if err := applyJSON(value.Index(i), items[i], validate, defaults); err != nil { return err } }
	case reflect.Map:
		var items map[string]json.RawMessage
		if len(raw) > 0 { if err := json.Unmarshal(raw, &items); err != nil { return err } }
		iter := value.MapRange()
		for iter.Next() {
			item := reflect.New(iter.Value().Type()).Elem()
			item.Set(iter.Value())
			if err := applyJSON(item, items[fmt.Sprint(iter.Key().Interface())], validate, defaults); err != nil { return err }
			value.SetMapIndex(iter.Key(), item)
		}
	}
	return nil
}

// ApplyDefaults initializes declared defaults on a newly constructed model.
func ApplyDefaults(input any) error { return applyJSON(reflect.ValueOf(input), nil, false, true) }

// DecodeJSON accepts exactly one JSON value, preserving numeric precision.
func DecodeJSON(data []byte, target any, ignoreUnknown, validate, defaults bool, shape ...string) error {
	if validate && len(shape) > 0 { if err := checkJSONShape("body", shape[0], data); err != nil { return err } }
	decoder := json.NewDecoder(bytes.NewReader(data))
	decoder.UseNumber()
	if !ignoreUnknown { decoder.DisallowUnknownFields() }
	if err := decoder.Decode(target); err != nil { return err }
	var trailing any
	if err := decoder.Decode(&trailing); err != io.EOF { if err != nil { return err }; return errors.New("trailing JSON value") }
	if err := applyJSON(reflect.ValueOf(target), bytes.TrimSpace(data), validate, defaults); err != nil { return err }
	if validate { return ValidateValue(target) }
	return nil
}

func encodeValue(value reflect.Value, raw json.RawMessage, encodeDefaults, explicitNulls bool) (json.RawMessage, error) {
	value = dereference(value)
	if absent(value) { return raw, nil }
	switch value.Kind() {
	case reflect.Struct:
		if len(raw) == 0 || raw[0] != '{' { return raw, nil }
		var fields map[string]json.RawMessage
		if err := json.Unmarshal(raw, &fields); err != nil { return nil, err }
		for i := 0; i < value.NumField(); i++ {
			field := value.Type().Field(i)
			if field.PkgPath != "" || field.Tag.Get("tsp") == "" { continue }
			name := strings.Split(field.Tag.Get("json"), ",")[0]
			item, present := fields[name]
			if !present && encodeDefaults {
				var err error
				item, err = json.Marshal(value.Field(i).Interface())
				if err != nil { return nil, err }
				present = true
			}
			if !present { continue }
			if (!explicitNulls && bytes.Equal(item, []byte("null"))) || (!encodeDefaults && strings.HasPrefix(field.Tag.Get("tsp"), "optional,") && field.Tag.Get("default") != "" && bytes.Equal(item, []byte(field.Tag.Get("default")))) {
				delete(fields, name)
				continue
			}
			encoded, err := encodeValue(value.Field(i), item, encodeDefaults, explicitNulls)
			if err != nil { return nil, err }
			fields[name] = encoded
		}
		return json.Marshal(fields)
	case reflect.Slice, reflect.Array:
		if len(raw) == 0 || raw[0] != '[' { return raw, nil }
		var items []json.RawMessage
		if err := json.Unmarshal(raw, &items); err != nil { return nil, err }
		for i := range items {
			encoded, err := encodeValue(value.Index(i), items[i], encodeDefaults, explicitNulls)
			if err != nil { return nil, err }
			items[i] = encoded
		}
		return json.Marshal(items)
	case reflect.Map:
		if len(raw) == 0 || raw[0] != '{' { return raw, nil }
		var items map[string]json.RawMessage
		if err := json.Unmarshal(raw, &items); err != nil { return nil, err }
		iter := value.MapRange()
		for iter.Next() {
			name := fmt.Sprint(iter.Key().Interface())
			encoded, err := encodeValue(iter.Value(), items[name], encodeDefaults, explicitNulls)
			if err != nil { return nil, err }
			items[name] = encoded
		}
		return json.Marshal(items)
	}
	return raw, nil
}

// EncodeJSON applies target JSON policies to generated model properties.
func EncodeJSON(input any, encodeDefaults, explicitNulls bool) ([]byte, error) {
	raw, err := json.Marshal(input)
	if err != nil { return nil, err }
	return encodeValue(reflect.ValueOf(input), raw, encodeDefaults, explicitNulls)
}

// DecodeParameter decodes scalar HTTP text without interpreting strings as JSON.
func DecodeParameter(raw string, target any) error {
	value := reflect.ValueOf(target)
	if value.Kind() != reflect.Pointer || value.IsNil() { return errors.New("parameter target must be a nonnil pointer") }
	value = value.Elem()
	for value.Kind() == reflect.Pointer { if value.IsNil() { value.Set(reflect.New(value.Type().Elem())) }; value = value.Elem() }
	if value.CanAddr() {
		if decoder, ok := value.Addr().Interface().(encoding.TextUnmarshaler); ok { return decoder.UnmarshalText([]byte(raw)) }
	}
	if value.Kind() == reflect.String && value.Type() != reflect.TypeOf(json.Number("")) { value.SetString(raw); return nil }
	if strings.TrimSpace(raw) == "null" { return errors.New("parameter must not be null") }
	if value.Type() == reflect.TypeOf(json.Number("")) && strings.HasPrefix(strings.TrimSpace(raw), "\"") { return errors.New("invalid number") }
	return json.Unmarshal([]byte(raw), target)
}

// EncodeParameter uses text codecs (including time.Time) or scalar formatting.
func EncodeParameter(input any) (string, error) {
	value := dereference(reflect.ValueOf(input))
	if absent(value) { return "", errors.New("parameter must not be null") }
	if encoder, ok := value.Interface().(encoding.TextMarshaler); ok { raw, err := encoder.MarshalText(); return string(raw), err }
	return fmt.Sprint(value.Interface()), nil
}
