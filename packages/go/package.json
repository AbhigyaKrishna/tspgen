  "files": ["dist", "lib", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@abhigyakrishna/tspgen-core": "workspace:*"
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.16.0",
    "@typespec/http": "^1.16.0"
  },
  "devDependencies": {
    "@typespec/compiler": "1.16.0",
    "@typespec/http": "1.16.0"
  }
}
