/**
 * Maps the <%= it.service.name %> API's exceptions to responses. Typed exceptions answer their declared body; every other error the
 * generated routes raise goes to [responder] as a [ServerError] (default: <%= it.problem ? "an RFC 9457 problem" : "the status without a body" %>). A handler registered
 * after this call replaces the one here for the same exception class.
 */
<%= it.h.visibility(it) %>fun StatusPagesConfig.<%= it.errorsFn %>(responder: ServerErrorResponder = { <%~ it.problem ? "respondProblem(it.status, it.detail)" : "respond(it.status)" %> }) {
<% for (const e of it.exceptions) { -%>
    exception<<%= e %>> { call, cause ->
<% const serializer = it.exceptionSerializers?.[e]; -%>
<% if (serializer) { -%>
        call.respondJson(HttpStatusCode.fromValue(cause.status), <%~ serializer %>, cause.error)
<% } else { -%>
        call.respond(HttpStatusCode.fromValue(cause.status), cause.error)
<% } -%>
    }
<% } -%>
<% for (const e of ["ApiException", "BadRequestException", "PayloadTooLargeException", "ContentTransformationException"]) { -%>
    exception<<%= e %>> { call, cause ->
        responder(call, call.serverErrorOf(cause)!!)
    }
<% } -%>
}
