<% const u = it.unit; const s = it.h.ktorServer; -%>
<%= it.h.visibility(it) %>interface <%= u.serviceName %> {
<% for (const op of u.operations) { -%>
<%~ it.h.kdoc(op.docs, "    ") %><%~ it.h.annotations([...op.annotations, ...it.extras[op.id].annotations], "    ") %>    suspend fun <%= op.name %>(<%= s.handlerParams(op, it.options) %>)<%= op.result.type.text === "Unit" ? "" : ": " + op.result.type.text %>
<% } -%>
<% if (it.options["handler-shape"] === "request-object") { for (const op of u.operations) { const fields = s.requestFields(op); if (fields.length === 0) continue; -%>

    data class <%= s.requestName(op) %>(
<% for (const f of fields) { -%>
        val <%= f.name %>: <%= f.type.text %>,
<% } -%>
    )
<% } } -%>
}