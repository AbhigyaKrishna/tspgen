<% const s = it.h.ktorServer; const params = it.units.map((u) => `${s.paramName(u)}: ${u.serviceName}`).join(", "); const args = it.units.map((u) => s.paramName(u)).join(", "); -%>
/**
 * Installs content negotiation<%= it.statusPages ? ", error handling" : "" %> and all <%= it.service.name %> routes.
 */
<%= it.h.visibility(it) %>fun Application.<%= it.moduleFn %>(<%= params %>) {
    install(ContentNegotiation) {
        json(serverJson)
    }
<% for (const p of it.installs) { -%>
    install(<%= it.h.simpleName(p) %>)
<% } -%>
<% if (it.statusPages) { -%>
    install(StatusPages) {
        <%= it.errorsFn %>()
    }
<% } -%>
    routing {
        <%= it.apiRoutesFn %>(<%= args %>)
    }
}

<%= it.h.visibility(it) %>fun Route.<%= it.apiRoutesFn %>(<%= params %>) {
<% for (const [i, u] of it.units.entries()) { -%>
<% for (const fn of it.mounts[i]) { -%>
    <%= fn %>(<%= s.paramName(u) %>)
<% } -%>
<% } -%>
}
