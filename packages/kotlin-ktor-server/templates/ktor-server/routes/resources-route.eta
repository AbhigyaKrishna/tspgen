<% const op = it.op; const u = it.unit; const s = it.h.ktorServer; -%>
<% if (s.needsDslRoute(op)) { %><%~ include("ktor-server/routes/dsl-route", it) %><% } else { -%>
    <%= op.verb %><<%= u.resourcesObject %>.<%= s.resourceName(op) %>> { resource ->
<% for (const p of op.params) { -%>
        val <%= p.name %> = <%~ p.location === "path" || p.location === "query" ? "resource." + p.name : s.paramExpr(p) %>
<% } -%>
<% const checks = op.params.flatMap(p => p.checks ?? []); if (checks.length) { -%>
        validRequest {
<% for (const check of checks) { -%>
            <%~ check %>
<% } -%>
        }
<% } -%>
<% for (const line of s.bodyLines(op)) { -%>
        <%~ line %>
<% } -%>
<% if (!op.upload && op.body?.checks?.length) { -%>
        validRequest {
<% for (const check of op.body.checks) { -%>
            <%~ check %>
<% } -%>
        }
<% } -%>
<% for (const c of op.context ?? []) { -%>
        val <%= c.name %> = <%~ c.expr %>
<% } -%>
<%~ include("ktor-server/routes/respond", { op, call: s.callExpr(op, u, it.options), h: it.h }) -%>
    }<% } -%>
