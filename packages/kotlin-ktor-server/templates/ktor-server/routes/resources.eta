<% const u = it.unit; const s = it.h.ktorServer; -%>
object <%= u.resourcesObject %> {
<% u.operations.forEach((op, i) => { const params = s.resourceParams(op); -%>
<% if (i > 0) { -%>

<% } -%>
    @Serializable
    @Resource(<%~ it.h.str(op.path) %>)
    class <%= s.resourceName(op) %><% if (params.length) { %>(<%= params.map((p) => (p.serialName ? `@SerialName(${it.h.str(p.serialName)}) ` : "") + "val " + p.name + ": " + p.type + (p.optional ? " = null" : "")).join(", ") %>)<% } %>
<% }) -%>
}

fun Route.<%= u.routesFn %>(service: <%= u.serviceName %>) {
<% for (const op of u.operations) { const auth = it.extras[op.id].authenticate; const route = include("ktor-server/routes/resources-route", { op, unit: u, options: it.options, h: it.h }); -%>
<% if (auth.length) { -%>
    authenticate(<%~ auth.map((a) => it.h.str(a)).join(", ") %>) {
<%~ it.h.indent(route, "    ") %>
    }
<% } else { -%>
<%~ route %>
<% } -%>
<% } -%>
}