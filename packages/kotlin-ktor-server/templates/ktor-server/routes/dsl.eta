<% const u = it.unit; -%>
<% for (const [i, fn] of it.routeFunctions.entries()) { const body = include("ktor-server/routes/dsl-nodes", { nodes: fn.nodes, unit: u, options: it.options, h: it.h }).trimEnd(); -%>
<% if (i > 0) { -%>

<% } -%>
fun Route.<%= fn.name %>(service: <%= u.serviceName %>) {
<% if (fn.prefix) { -%>
    route(<%~ it.h.str(fn.prefix) %>) {
<%~ it.h.indent(body, "    ") %>
    }
<% } else { -%>
<%~ body %>
<% } -%>
}
<% } -%>
