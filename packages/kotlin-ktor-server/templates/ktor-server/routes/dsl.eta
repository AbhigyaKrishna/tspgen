<% const u = it.unit; -%>
fun Route.<%= u.routesFn %>(service: <%= u.serviceName %>) {
<% for (const op of u.operations) { const auth = it.extras[op.id].authenticate; const route = include("ktor-server/routes/dsl-route", { op, unit: u, options: it.options, h: it.h }); -%>
<% if (auth.length) { -%>
    authenticate(<%~ auth.map((a) => it.h.str(a)).join(", ") %>) {
<%~ it.h.indent(route, "    ") %>
    }
<% } else { -%>
<%~ route %>
<% } -%>
<% } -%>
}