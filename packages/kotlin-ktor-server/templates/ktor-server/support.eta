internal fun ApplicationCall.pathParam(name: String): String =
    parameters[name] ?: throw MissingRequestParameterException(name)

internal fun ApplicationCall.queryParam(name: String): String? = request.queryParameters[name]

internal fun ApplicationCall.queryParams(name: String): List<String> =
    request.queryParameters.getAll(name) ?: emptyList()

internal fun ApplicationCall.headerParam(name: String): String? = request.headers[name]

internal fun ApplicationCall.cookieParam(name: String): String? = request.cookies[name]

internal fun <T : Any> T?.required(name: String): T = this ?: throw MissingRequestParameterException(name)

internal inline fun <T> String.convertParam(name: String, convert: (String) -> T): T =
    try {
        convert(this)
    } catch (e: Exception) {
        throw ParameterConversionException(name, "value", e)
    }

@PublishedApi
internal val paramJson: Json = Json { isLenient = true }

internal inline fun <reified T> decodeParam(raw: String): T = paramJson.decodeFromJsonElement(JsonPrimitive(raw))

internal inline fun <reified T> encodeParam(value: T): String =
    when (val element = paramJson.encodeToJsonElement(value)) {
        is JsonPrimitive -> element.content
        else -> element.toString()
    }
<% if (it.serverJson) { -%>

/**
 * JSON of request and response bodies, multipart JSON parts and event payloads: Ktor's DefaultJson with this
 * target's `features.encode-defaults` / `features.ignore-unknown-keys` and the models' serializers. Without the
 * generated module, install it yourself: `install(ContentNegotiation) { json(serverJson) }`.
 */
<%= it.h.visibility(it) %><%~ it.serverJson %>
<% } -%>
<% if (it.receiveJson) { -%>

/**
 * Reads a JSON request body with [serializer] and [serverJson]: bodies whose JSON form their Kotlin type does not carry
 * (`@encode(string)` int64 values in a list, …), which `receive<T>()` would read with the type's own serializer. A
 * non-JSON content type fails with [UnsupportedMediaTypeException] (415), a body that does not decode with
 * [BadRequestException] (400); an empty body is null for a nullable [serializer] (an optional body).
 */
internal suspend fun <T> ApplicationCall.receiveJson(serializer: KSerializer<T>): T {
    val text = receiveText()
    if (text.isBlank() && serializer.descriptor.isNullable) return serverJson.decodeFromString(serializer, "null")
    val type = request.contentType()
    if (!type.match(ContentType.Application.Json) && !type.contentSubtype.endsWith("+json")) {
        throw UnsupportedMediaTypeException(type)
    }
    return try {
        serverJson.decodeFromString(serializer, text)
    } catch (e: IllegalArgumentException) {
        // SerializationException (malformed JSON, missing or unknown fields) and model checks (`require`).
        throw BadRequestException("Failed to convert request body", e)
    }
}
<% } -%>
<% if (it.respondJson) { -%>

/** Responds with [value] as JSON written by [serializer] and [serverJson] (see `receiveJson`). */
internal suspend fun <T> ApplicationCall.respondJson(status: HttpStatusCode, serializer: KSerializer<T>, value: T) =
    respondText(serverJson.encodeToString(serializer, value), ContentType.Application.Json, status)
<% } -%>
<% if (it.problem) { -%>

/**
 * Responds with an RFC 9457 problem: `application/problem+json` carrying `type` (about:blank), the status's `title`,
 * `status` and [detail] when given.
 */
internal suspend fun ApplicationCall.respondProblem(status: HttpStatusCode, detail: String?) {
    val problem = buildJsonObject {
        put("type", "about:blank")
        put("title", status.description)
        put("status", status.value)
        if (detail != null) put("detail", detail)
    }
    respondText(problem.toString(), ContentType.Application.ProblemJson, status)
}

/**
 * The detail of a 400 problem. A missing or unconvertible parameter keeps its message, as do the multipart checks and
 * a model check that failed (`require`: an IllegalArgumentException, e.g. "name must not be blank"). A body that does not decode reads
 * "Malformed request body", with the fields missing and the JSON path of the failure when known: kotlinx's own messages
 * name model classes and echo the request body, so they are not sent.
 */
@OptIn(ExperimentalSerializationApi::class) // MissingFieldException.missingFields
internal fun BadRequestException.problemDetail(): String? {
    if (this is MissingRequestParameterException || this is ParameterConversionException) return message
    val causes = generateSequence(cause) { it.cause }.toList()
    val innermost = causes.lastOrNull() ?: return message
    // A copy of our own exception (coroutines' stack-trace recovery chains the original as its cause), or a model check.
    if (innermost is BadRequestException || (innermost is IllegalArgumentException && innermost !is SerializationException)) {
        return innermost.message
    }
    val missing = causes.filterIsInstance<MissingFieldException>().lastOrNull()?.missingFields.orEmpty()
    val path = causes.lastOrNull { it is SerializationException }?.message?.let { JSON_PATH.find(it)?.groupValues?.get(1) }
    return buildString {
        append("Malformed request body")
        if (missing.isNotEmpty()) append(missing.joinToString(prefix = ": missing ") { "'$it'" })
        if (path != null) append(" at path ").append(path)
    }
}

/** The `at path: $.x` part of a kotlinx decoding message. */
private val JSON_PATH = Regex("""at path:? (\$\S*)""")
<% } -%>
<% if (it.uploads?.limit) { -%>


/**
 * Runs [block] on the request's multipart parts, each limited to [limit] bytes. Ktor parses the request alongside
 * [block] (in a child coroutine); when that parser fails on the limit, the call fails with [PayloadTooLargeException],
 * which Ktor answers with 413. Whatever [block] throws on its own propagates unchanged.
 */
internal suspend fun <T> ApplicationCall.withMultipart(limit: Long, block: suspend (MultiPartData) -> T): T {
    val parserFailure = AtomicReference<Throwable>()
    try {
        return coroutineScope {
            val data = receiveMultipart(formFieldLimit = limit)
            coroutineContext.job.children.forEach { parser ->
                parser.invokeOnCompletion { cause ->
                    if (cause != null && cause !is CancellationException) parserFailure.compareAndSet(null, cause)
                }
            }
            block(data)
        }
    } catch (e: Throwable) {
        if (parserFailure.get().isPartOverLimit()) throw PayloadTooLargeException(limit)
        throw e
    }
}

/** Ktor's multipart parser failing on a part over `formFieldLimit` (Ktor 3's wordings). */
private fun Throwable?.isPartOverLimit(): Boolean {
    val message = (this as? IOException)?.message ?: return false
    return message.startsWith("Multipart content length exceeds limit ") ||
        (message.startsWith("Limit of ") && message.contains(" bytes exceeded"))
}
<% } -%>
<% if (it.uploads?.parts) { -%>

/** The text of a multipart part (a part sent as a file is decoded as UTF-8). */
internal suspend fun PartData.partText(): String =
    when (this) {
        is PartData.FormItem -> value
        is PartData.FileItem -> provider().toByteArray().decodeToString()
        is PartData.BinaryChannelItem -> provider().toByteArray().decodeToString()
        else -> throw BadRequestException("Unsupported multipart part '$name'")
    }
<% } -%>
<% if (it.uploads?.buffered) { -%>

/**
 * A multipart request read into memory: the declared text values<% if (it.uploads.files) { %> and files<% } %> by part name, in arrival order. A part
 * not in `multiParts` may be sent once (400 otherwise); the parts together may buffer at most `limit` bytes (413 otherwise).
 */
internal class ReceivedParts(private val limit: Long, private val multiParts: Set<String>) {
    private val textValues = mutableMapOf<String, MutableList<String>>()
<% if (it.uploads.files) { -%>
    private val fileValues = mutableMapOf<String, MutableList<HttpFile>>()
<% } -%>
    private var size = 0L

    fun text(name: String): String? = textValues[name]?.firstOrNull()

    fun texts(name: String): List<String> = textValues[name].orEmpty()
<% if (it.uploads.files) { -%>

    fun file(name: String): HttpFile? = fileValues[name]?.firstOrNull()

    fun files(name: String): List<HttpFile> = fileValues[name].orEmpty()
<% } -%>

    /** Checks that part [name] may be read (again). */
    fun expect(name: String) {
        if (name !in multiParts && (name in textValues<% if (it.uploads.files) { %> || name in fileValues<% } %>)) {
            throw BadRequestException("Part '$name' must be sent at most once")
        }
    }

    fun addText(name: String, value: String) {
        buffer(value.utf8Size())
        textValues.getOrPut(name) { mutableListOf() }.add(value)
    }
<% if (it.uploads.files) { -%>

    fun addFile(name: String, file: HttpFile) {
        buffer(file.bytes.size.toLong())
        fileValues.getOrPut(name) { mutableListOf() }.add(file)
    }
<% } -%>

    private fun buffer(bytes: Long) {
        size += bytes
        if (size > limit) throw PayloadTooLargeException(limit)
    }
}

private fun String.utf8Size(): Long =
    sumOf { c -> if (c.code < 0x80) 1L else if (c.code < 0x800 || c.isSurrogate()) 2L else 3L }

/**
 * Reads the declared parts of a multipart request into memory: `textParts` as text<% if (it.uploads.files) { %>, `fileParts` as files<% } %>. Other parts
 * are released unread. A part over `limit` bytes, or declared parts over `limit` bytes together, answer 413; a part not
 * in `multiParts` sent more than once answers 400.
 */
internal suspend fun ApplicationCall.receiveParts(
    limit: Long,
    textParts: Set<String>,
<% if (it.uploads.files) { -%>
    fileParts: Set<String> = emptySet(),
<% } -%>
    multiParts: Set<String> = emptySet(),
): ReceivedParts {
    val parts = ReceivedParts(limit, multiParts)
    withMultipart(limit) { data ->
        data.forEachPart { part ->
            try {
                val name = part.name
                when {
                    name == null -> Unit
                    name in textParts -> {
                        parts.expect(name)
                        parts.addText(name, part.partText())
                    }
<% if (it.uploads.files) { -%>
                    name in fileParts -> {
                        parts.expect(name)
                        parts.addFile(name, part.partFile())
                    }
<% } -%>
                }
            } finally {
                part.release()
            }
        }
    }
    return parts
}

/**
 * Runs [build], turning a model check that fails (`init { require(…) }`, an IllegalArgumentException) into a
 * [BadRequestException] carrying its message, so invalid input answers 400 instead of 500.
 */
internal inline fun <T> validRequest(build: () -> T): T =
    try {
        build()
    } catch (e: IllegalArgumentException) {
        throw BadRequestException(e.message ?: "Invalid request", e)
    }
<% } -%>
<% if (it.uploads?.files) { -%>

/** A file part read into memory. A part sent without a filename is rejected: Ktor reads it as (UTF-8) text. */
internal suspend fun PartData.partFile(): HttpFile =
    when (this) {
        is PartData.FileItem -> HttpFile(originalFileName, contentType?.toString(), provider().toByteArray())
        is PartData.BinaryChannelItem -> HttpFile(null, contentType?.toString(), provider().toByteArray())
        is PartData.FormItem -> throw BadRequestException("File part '$name' must be sent with a filename")
        else -> throw BadRequestException("Unsupported multipart part '$name'")
    }
<% } -%>
<% if (it.uploads?.streaming) { -%>

/**
 * The parts of a multipart request as a flow that reads the request while it is collected: `emitPart` emits the
 * declared parts, the others are released unread. The flow can be collected once; a part over `limit` bytes answers 413.
 */
internal fun <T> ApplicationCall.partsFlow(limit: Long, emitPart: suspend FlowCollector<T>.(PartData) -> Unit): <%= it.flowType %><T> {
    val collected = AtomicBoolean()
    return flow {
        check(collected.compareAndSet(false, true)) { "The parts of a multipart request can be collected only once" }
        withMultipart(limit) { data ->
            data.forEachPart { part ->
                try {
                    emitPart(part)
                } finally {
                    part.release()
                }
            }
        }
    }
}
<% } -%>
<% if (it.uploads?.channel) { -%>

/**
 * A file part's content as a channel, readable until the part is released. A part sent without a filename is
 * rejected: Ktor reads it as (UTF-8) text.
 */
internal fun PartData.partChannel(): ByteReadChannel =
    when (this) {
        is PartData.FileItem -> provider()
        is PartData.BinaryChannelItem -> provider()
        is PartData.FormItem -> throw BadRequestException("File part '$name' must be sent with a filename")
        else -> throw BadRequestException("Unsupported multipart part '$name'")
    }

internal fun PartData.partFileName(): String? = (this as? PartData.FileItem)?.originalFileName
<% } -%>
<% if (it.uploads?.file) { -%>

/**
 * Reads a file request body of at most `limit` bytes (larger ones answer 413); the filename comes from a
 * Content-Disposition header when present.
 */
internal suspend fun ApplicationCall.receiveFile(limit: Long): HttpFile {
    if ((request.headers[HttpHeaders.ContentLength]?.toLongOrNull() ?: 0L) > limit) throw PayloadTooLargeException(limit)
    val bytes = receiveChannel().readBuffer(limit + 1).readByteArray()
    if (bytes.size > limit) throw PayloadTooLargeException(limit)
    return HttpFile(
        request.headers[HttpHeaders.ContentDisposition]?.let { ContentDisposition.parse(it).parameter(ContentDisposition.Parameters.FileName) },
        request.headers[HttpHeaders.ContentType],
        bytes,
    )
}
<% } -%><% if (it.sse) { -%>



/**
 * One server-sent event as written: `event:` (none for the default "message" type), `data:` and `id:`. CR and LF
 * would end the `event:` / `id:` line early and let the rest forge fields or whole events, so they are removed; an
 * id containing NUL is dropped (clients ignore it).
 */
internal class TspgenSseFrame(event: String?, val data: String, id: String? = null, val terminal: Boolean = false) {
    val event: String? = event?.filterNot { it == '\r' || it == '\n' }?.ifEmpty { null }
    val id: String? = id?.takeUnless { '\u0000' in it }?.filterNot { it == '\r' || it == '\n' }
}

/** The frames of [events] up to and including the first terminal one: the stream ends after it. */
internal fun <T> kotlinx.coroutines.flow.Flow<T>.sseFrames(frame: (T) -> TspgenSseFrame): kotlinx.coroutines.flow.Flow<TspgenSseFrame> =
    map(frame).transformWhile {
        emit(it)
        !it.terminal
    }
<% if (it.sse.textWriter) { -%>

/**
 * Responds with [events] as `text/event-stream`, written (without blocking) and flushed one event at a time; multi-line
 * data is sent as several `data:` lines (CR and CRLF line breaks as LF). The flow is collected only once the response
 * has started: throw before returning it to answer with an error status instead.
 */
internal suspend fun <T> ApplicationCall.respondEventStream(events: kotlinx.coroutines.flow.Flow<T>, frame: (T) -> TspgenSseFrame) {
<% for (const [name, value] of it.sse.headers) { -%>
    response.header(<%~ name %>, <%~ value %>)
<% } -%>
    respondBytesWriter(ContentType.Text.EventStream) {
        events.sseFrames(frame).collect { f ->
            val text = StringBuilder()
            f.event?.let { text.append("event: ").append(it).append('\n') }
            for (line in f.data.split("\r\n", "\r", "\n")) text.append("data: ").append(line).append('\n')
            f.id?.let { text.append("id: ").append(it).append('\n') }
            writeStringUtf8(text.append('\n').toString())
            flush()
        }
    }
}
<% } -%>
<% if (it.sse.plugin) { -%>

/**
 * Responds with [events] through the ktor-server-sse plugin's session ([SSE] must be installed), one
 * [ServerSentEvent] per event. The flow is collected only once the response has started: throw before returning it
 * to answer with an error status instead.
 */
internal suspend fun <T> ApplicationCall.respondSse(events: kotlinx.coroutines.flow.Flow<T>, frame: (T) -> TspgenSseFrame) {
    application.plugin(SSE)
<% for (const [name, value] of it.sse.headers) { -%>
    response.header(<%~ name %>, <%~ value %>)
<% } -%>
    respond(
        SSEServerContent(this, {
            events.sseFrames(frame).collect { send(ServerSentEvent(data = it.data, event = it.event, id = it.id)) }
        }),
    )
}
<% } -%>
<% for (const f of it.sse.frames) { -%>

<%~ f %>
<% } -%>
<% } -%>
