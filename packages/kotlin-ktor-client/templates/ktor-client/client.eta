<% const g = it.group; const c = it.h.ktorClient; -%>
<%~ it.h.kdoc(g.docs) %><%~ it.h.annotations(g.annotations) %><%= it.h.visibility(it) %>class <%= g.name %>Client(
    private val http: HttpClient,
    private val baseUrl: String,
<% if (it.auth) { -%>
    private val auth: <%= it.auth %>? = null,
<% } -%>
) {
<% for (const p of it.authPlans ?? []) { -%>
    private val <%= p.name %> = <%~ p.alternatives %>
<% } -%>
<% g.operations.forEach((op, i) => { const segments = c.pathSegments(op); const auth = it.extras[op.id].auth; -%>
<% if (i > 0) { -%>

<% } -%>
<%~ it.h.kdoc(op.docs, "    ") %><%~ it.h.annotations([...op.annotations, ...it.extras[op.id].annotations], "    ") %><% const stream = c.stream(op); if (it.extras[op.id].webSocket) { -%>
<%~ include("ktor-client/websocket", { ...it, op }) -%>
<% } else if (c.scopedStream(op)) { -%>
<%~ include("ktor-client/scoped-stream", { ...it, op }) -%>
<% } else if (stream) { -%>
    fun <%= op.name %>(<%= c.signature(op) %>): <%= op.result.type.text %> = flow {
<% for (const check of [...op.params.flatMap(p => p.checks ?? []), ...(op.body?.checks ?? [])]) { -%>
        <%~ check %>
<% } -%>
<% for (const line of c.preludeLines(stream)) { -%>
        <%~ line %>
<% } -%>
<% if (auth) { -%>
        val <%= auth.variable %> = resolveAuth(<%~ auth.alternatives %>)
<% } -%>
        http.prepareRequest {
            expectSuccess = false
            method = HttpMethod.<%= c.method(op.verb) %>
            url {
                takeFrom(baseUrl)
<% if (segments) { -%>
                appendPathSegments(<%~ segments %>, encodeSlash = true)
<% } -%>
<% for (const line of c.queryLines(op)) { -%>
                <%~ line %>
<% } -%>
            }
            header(HttpHeaders.Accept, <%~ it.h.str(op.result.contentType ?? (stream.protocol === "jsonl" ? "application/jsonl" : "text/event-stream")) %>)
<% for (const line of c.requestLines(op)) { -%>
            <%~ line %>
<% } -%>
<% if (auth) { -%>
            applyAuth(<%= auth.variable %>)
<% } -%>
        }.execute { response ->
            if (!response.status.isSuccess()) {
<% if (c.typedErrors(op)) { -%>
                if (response.isProblem()) throw ApiException(response.status.value, response.errorMessage())
<% } -%>
                throw when (response.status.value) {
<% for (const e of c.errorBranches(op, it.bounded)) { -%>
                    <%= e.match %> -> <%~ e.expr %>
<% } -%>
                }
            }
<% if (stream.protocol === "bytes" || stream.protocol === "text") { -%>
            <%~ c.rawReader(stream) %> { emit(it) }
<% } else if (stream.protocol === "jsonl") { -%>
            response.bodyAsChannel().readJsonLines { line ->
                emit(http.apiJson.decodeFromString(<%~ it.h.jsonSerializer(stream.type) %>, line))
            }
<% } else { -%>
            response.bodyAsChannel().readSse { event ->
<% for (const line of c.emitLines(stream)) { -%>
                <%~ line %>
<% } -%>
            }
<% } -%>
        }
    }
<% } else { -%>
    suspend fun <%= op.name %>(<%= c.signature(op) %>)<%= op.result.type.text === "Unit" ? "" : ": " + op.result.type.text %> {
<% for (const check of [...op.params.flatMap(p => p.checks ?? []), ...(op.body?.checks ?? [])]) { -%>
        <%~ check %>
<% } -%>
<% if (auth) { -%>
        val <%= auth.variable %> = resolveAuth(<%~ auth.alternatives %>)
<% } -%>
        return executeApiRequest(http, baseUrl, HttpMethod.<%= c.method(op.verb) %>, listOf(<%~ segments %>), {
<% if (c.queryLines(op).length) { -%>
            url {
<% } -%>
<% for (const line of c.queryLines(op)) { -%>
                <%~ line %>
<% } -%>
<% if (c.queryLines(op).length) { -%>
            }
<% } -%>
<% for (const line of c.requestLines(op)) { -%>
            <%~ line %>
<% } -%>
<% if (auth) { -%>
            applyAuth(<%= auth.variable %>)
<% } -%>
        }, { response ->
<%~ it.h.indent(include("ktor-client/response", { op, h: it.h, bounded: it.bounded, returnLabel: "@executeApiRequest" }), "    ") %>
        })
    }
<% if (it.streaming && op.result.kind === "single" && op.result.type.text === "ByteArray") { -%>

<%~ include("ktor-client/raw-stream", { ...it, op }) %>
<% } -%>
<% } -%>
<% }) -%>
}
