<% const g = it.group; const c = it.h.ktorClient; -%>
<%~ it.h.kdoc(g.docs) %><%= it.h.visibility(it) %>class <%= g.name %>Client(
    private val http: HttpClient,
    private val baseUrl: String,
) {
<% g.operations.forEach((op, i) => { const segments = c.pathSegments(op); -%>
<% if (i > 0) { -%>

<% } -%>
<%~ it.h.kdoc(op.docs, "    ") %><%~ it.h.annotations([...op.annotations, ...it.extras[op.id].annotations], "    ") %><% const stream = c.stream(op); if (stream) { -%>
    fun <%= op.name %>(<%= c.signature(op) %>): <%= op.result.type.text %> = flow {
<% for (const line of c.preludeLines(stream)) { -%>
        <%~ line %>
<% } -%>
        http.prepareRequest {
            method = HttpMethod.<%= c.method(op.verb) %>
            url {
                takeFrom(baseUrl)
<% if (segments) { -%>
                appendPathSegments(<%~ segments %>)
<% } -%>
<% for (const line of c.queryLines(op)) { -%>
                <%~ line %>
<% } -%>
            }
            header(HttpHeaders.Accept, "text/event-stream")
<% for (const line of c.requestLines(op)) { -%>
            <%~ line %>
<% } -%>
        }.execute { response ->
            if (!response.status.isSuccess()) {
                throw when (response.status.value) {
<% for (const e of c.errorBranches(op)) { -%>
                    <%= e.match %> -> <%~ e.expr %>
<% } -%>
                }
            }
            response.bodyAsChannel().readSse { event ->
<% for (const line of c.emitLines(stream)) { -%>
                <%~ line %>
<% } -%>
            }
        }
    }
<% } else { -%>
    suspend fun <%= op.name %>(<%= c.signature(op) %>)<%= op.result.type.text === "Unit" ? "" : ": " + op.result.type.text %> {
        val response = http.request {
            method = HttpMethod.<%= c.method(op.verb) %>
            url {
                takeFrom(baseUrl)
<% if (segments) { -%>
                appendPathSegments(<%~ segments %>)
<% } -%>
<% for (const line of c.queryLines(op)) { -%>
                <%~ line %>
<% } -%>
            }
<% for (const line of c.requestLines(op)) { -%>
            <%~ line %>
<% } -%>
        }
<%~ include("ktor-client/response", { op, h: it.h }) %>
    }
<% } -%>
<% }) -%>
}