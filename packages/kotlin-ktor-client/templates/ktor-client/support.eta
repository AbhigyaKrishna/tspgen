<% if (it.auth.basic) { -%>
/** Username and password of an HTTP Basic auth scheme, sent as `Authorization: Basic …` (UTF-8, base64). */
<%= it.h.visibility(it) %>data class BasicCredentials(val username: String, val password: String)

<% } -%>
/** Where an auth scheme's credential is sent. */
internal enum class AuthPlacement { BEARER, <% if (it.auth.basic) { %>BASIC, <% } %>HEADER, QUERY, COOKIE }

/**
 * One scheme of an operation's auth requirement: its id, where and under which name its credential is sent, and
 * the provider of the credential.
 */
internal class AuthScheme(val id: String, val placement: AuthPlacement, val name: String, val provider: (suspend () -> Any?)?)

/**
 * The credentials of the first alternative whose providers all return one; empty when none does (the server
 * decides). Each provider is called at most once; null and "" count as no credential.
 */
internal suspend fun resolveAuth(alternatives: List<List<AuthScheme>>): List<Pair<AuthScheme, Any>> {
    val values = HashMap<String, Any?>()
    for (alternative in alternatives) {
        val found = ArrayList<Pair<AuthScheme, Any>>()
        for (scheme in alternative) {
            val value = if (scheme.id in values) values[scheme.id] else scheme.provider?.invoke().also { values[scheme.id] = it }
            if (value == null || value == "") break
            found += scheme to value
        }
        if (found.size == alternative.size) return found
    }
    return emptyList()
}

/** Sends resolved credentials: they replace a header or query parameter of the same name; cookies are added. */
internal fun HttpRequestBuilder.applyAuth(credentials: List<Pair<AuthScheme, Any>>) {
    for ((scheme, value) in credentials) {
        when (scheme.placement) {
            AuthPlacement.BEARER -> headers[HttpHeaders.Authorization] = "Bearer $value"
<% if (it.auth.basic) { -%>
            AuthPlacement.BASIC -> {
                val basic = value as BasicCredentials
                headers[HttpHeaders.Authorization] = "Basic " + "${basic.username}:${basic.password}".encodeBase64()
            }
<% } -%>
            AuthPlacement.HEADER -> headers[scheme.name] = value.toString()
            AuthPlacement.QUERY -> url.parameters[scheme.name] = value.toString()
            AuthPlacement.COOKIE -> cookie(scheme.name, value.toString())
        }
    }
}
<% } -%>
