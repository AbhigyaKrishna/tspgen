export type HeadersInput = HeadersInit | (() => HeadersInit | Promise<HeadersInit>);

export interface ClientConfig {
  /** Absolute API URL, or a path such as "/api" when running in the browser. */
  baseUrl: string;
  /** Custom fetch implementation (defaults to the global fetch). */
  fetch?: typeof fetch;
  /** Headers sent with every request; may be async (e.g. auth read from cookies()). */
  headers?: HeadersInput;
  /** Validate response bodies with the generated zod schemas when available (default true). */
  validate?: boolean;
}

/** Per-call options passed through to fetch, including Next.js caching. */
export interface RequestOptions {
  next?: { revalidate?: number | false; tags?: string[] };
  cache?: RequestCache;
  signal?: AbortSignal;
  headers?: HeadersInit;
}

type Scalar = string | number | boolean | null | undefined;

export type ParamValue = Scalar | readonly Scalar[];
<% if (it.uploads) { -%>

/** One part of a multipart body: wire name, body property (when it differs) and encoding. */
export interface PartSpec {
  name: string;
  key?: string;
  kind: "file" | "text" | "json";
  multi: boolean;
  /** Declared content type: given to untyped blobs of a file part; a JSON part's (application/json when absent). */
  contentType?: string;
}
<% } -%>

export interface RequestSpec {
  method: string;
  path: string;
  /** [name, value, explode] */
  query?: ReadonlyArray<readonly [string, ParamValue, boolean]>;
  headers?: Record<string, ParamValue>;
  cookies?: Record<string, ParamValue>;
  body?: unknown;
  contentType?: string;
<% if (it.uploads) { -%>
  /** Multipart body: `body` is sent as FormData built from these parts (fetch sets the boundary). */
  multipart?: readonly PartSpec[];
  /** File body: `body` is a Blob sent as-is. */
  file?: boolean;
<% } -%>
}

/** Minimal schema contract, satisfied by zod schemas. */
export interface Schema<T> {
  parse(value: unknown): T;
}

export type ErrorFactory = (status: number, body: unknown) => Error;

function encode(value: ParamValue): string | undefined {
  if (value === undefined || value === null) return undefined;
  return Array.isArray(value) ? value.map(String).join(",") : String(value);
}
<% if (it.uploads) { -%>

/**
 * FormData of a multipart request object: text parts as strings, JSON parts as blobs of their JSON content type, files
 * with their name (the part name for a plain Blob) and, when untyped, the part's declared content type; multi
 * parts append every item; absent parts are skipped.
 */
export function toFormData(value: object, parts: readonly PartSpec[]): FormData {
  const form = new FormData();
  const record = value as Record<string, unknown>;
  for (const part of parts) {
    const raw = record[part.key ?? part.name];
    if (raw === undefined || raw === null) continue;
    for (const item of part.multi && Array.isArray(raw) ? raw : [raw]) {
      if (part.kind === "file") {
        const blob = item as Blob;
        const name = typeof File !== "undefined" && blob instanceof File ? blob.name : part.name;
        form.append(part.name, blob.type === "" && part.contentType ? new Blob([blob], { type: part.contentType }) : blob, name);
      } else if (part.kind === "json") {
        form.append(part.name, new Blob([JSON.stringify(item)], { type: part.contentType ?? "application/json" }));
      } else {
        form.append(part.name, String(item));
      }
    }
  }
  return form;
}
<% } -%>

function resolveUrl(baseUrl: string, path: string): URL {
  const origin = (globalThis as { location?: { origin: string } }).location?.origin;
  return new URL(baseUrl.replace(/\/+$/, "") + path, origin);
}

export async function request(config: ClientConfig, spec: RequestSpec, options: RequestOptions = {}): Promise<Response> {
  const url = resolveUrl(config.baseUrl, spec.path);
  for (const [name, value, explode] of spec.query ?? []) {
    if (Array.isArray(value) && explode) {
      for (const item of value) url.searchParams.append(name, String(item));
      continue;
    }
    const encoded = encode(value);
    if (encoded !== undefined) url.searchParams.append(name, encoded);
  }
  const headers = new Headers(typeof config.headers === "function" ? await config.headers() : config.headers);
  new Headers(options.headers).forEach((headerValue, headerName) => headers.set(headerName, headerValue));
  for (const [name, headerValue] of Object.entries(spec.headers ?? {})) {
    const encoded = encode(headerValue);
    if (encoded !== undefined) headers.set(name, encoded);
  }
  const cookies = Object.entries(spec.cookies ?? {}).flatMap(([name, cookieValue]) => {
    const encoded = encode(cookieValue);
    return encoded === undefined ? [] : [`${name}=${encodeURIComponent(encoded)}`];
  });
  if (cookies.length > 0) headers.append("cookie", cookies.join("; "));
<% if (it.uploads) { -%>
  let body: BodyInit | undefined;
  if (spec.body !== undefined && spec.multipart) {
    // fetch writes multipart/form-data with its boundary itself.
    headers.delete("content-type");
    body = toFormData(spec.body as object, spec.multipart);
  } else if (spec.body !== undefined && spec.file) {
    const blob = spec.body as Blob;
    headers.set("content-type", blob.type || spec.contentType || "application/octet-stream");
    body = blob;
  } else if (spec.body !== undefined) {
<% } else { -%>
  let body: string | undefined;
  if (spec.body !== undefined) {
<% } -%>
    const contentType = spec.contentType ?? "application/json";
    headers.set("content-type", contentType);
    body = contentType.includes("json") || typeof spec.body !== "string" ? JSON.stringify(spec.body) : spec.body;
  }
  const init: RequestInit & { next?: RequestOptions["next"] } = { method: spec.method, headers };
  if (body !== undefined) init.body = body;
  if (options.cache !== undefined) init.cache = options.cache;
  if (options.signal !== undefined) init.signal = options.signal;
  if (options.next !== undefined) init.next = options.next;
  return (config.fetch ?? fetch)(url, init);
}

/** Reads a response body: JSON when the content type says so, text otherwise, undefined when empty. */
export async function readBody(res: Response): Promise<unknown> {
  const raw = await res.text();
  if (!raw) return undefined;
  return (res.headers.get("content-type") ?? "").includes("json") ? JSON.parse(raw) : raw;
}

export async function parse<T>(config: ClientConfig, res: Response, schema?: Schema<T>): Promise<T> {
  const body = await readBody(res);
  return schema && config.validate !== false ? schema.parse(body) : (body as T);
}

/** Maps an error response to an error instance by exact status, status class ("4XX") or default. */
export async function toError(res: Response, factories: Record<string, ErrorFactory>): Promise<Error> {
  const body = await readBody(res).catch(() => undefined);
  const factory = factories[String(res.status)] ?? factories[`${Math.floor(res.status / 100)}XX`] ?? factories.default;
  return factory ? factory(res.status, body) : new HttpError(res.status, body);
}

export function requireHeader(res: Response, name: string): string {
  const headerValue = res.headers.get(name);
  if (headerValue === null) throw new HttpError(res.status, undefined, `Missing response header '${name}'`);
  return headerValue;
}

export function optionalHeader<T = string>(res: Response, name: string, map?: (value: string) => T): T | undefined {
  const headerValue = res.headers.get(name);
  if (headerValue === null) return undefined;
  return map ? map(headerValue) : (headerValue as T);
}

/** `{ [key]: value }`, or `{}` when value is undefined: fills an optional property under exactOptionalPropertyTypes. */
export function optionalEntry<K extends string, T>(key: K, value: T | undefined): { [P in K]?: T } {
  return (value === undefined ? {} : { [key]: value }) as { [P in K]?: T };
}
