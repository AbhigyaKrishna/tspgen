<% const e = it.error; -%>
export type HeadersInput = globalThis.HeadersInit | (() => globalThis.HeadersInit | Promise<globalThis.HeadersInit>);

/** Next.js caching options (fetch's next). */
export interface NextFetchOptions {
  revalidate?: number | false;
  tags?: string[];
}

/** Client-wide fetch options (init in ClientOptions): every RequestInit field but method, body, headers, signal and window. */
export interface RequestDefaults extends Omit<globalThis.RequestInit, "method" | "body" | "headers" | "signal" | "window"> {
  next?: NextFetchOptions;
}

/** Per-call fetch options, over init and @meta next defaults; headers override the client's. */
export interface RequestOptions extends RequestDefaults {
  signal?: AbortSignal;
  headers?: globalThis.HeadersInit;
}

/**
 * `options` without `method`, `body`, `headers` or `window`: `RequestOptions` excludes them at the type level, but a
 * plain-JS caller (or an `as` cast) can still put them on the object at runtime; stripped before spreading `options`
 * into fetch's init so they can never override the client's own `method`/`headers`/`body` or leak `window` through.
 */
function safeInit(options: RequestOptions): RequestOptions {
  const rest = { ...options } as Record<string, unknown>;
  delete rest.method;
  delete rest.body;
  delete rest.headers;
  delete rest.window;
  return rest as RequestOptions;
}

<% if (it.usesAuth) { -%>
/** `Auth`: the client's `<Service>Auth` credential providers. */
export interface ClientOptions<Auth extends object = object> {
<% } else { -%>
export interface ClientOptions {
<% } -%>
  baseUrl: string;
  /** Custom fetch implementation (defaults to the global fetch). */
  fetch?: typeof fetch;
  /** Headers sent with every request; may be a function (sync or async), called per request. */
  headers?: HeadersInput;
  /** Fetch options for every request (credentials, cache, next, …); per-call options override them. */
  init?: RequestDefaults;
<% if (it.usesAuth) { -%>
  /**
   * Credential providers by auth scheme id: an operation's `@useAuth` credentials are sent (after `headers`, so
   * they win; per-call headers win over them) when its providers return them.
   */
  auth?: Auth;
<% } -%>
}

/** Thrown for every non-2xx response. */
export class <%= e.name %> extends Error {
  readonly status: number;
<% if (e.model) { -%>
  /** The decoded error body (<%= e.model %>), when the response carried one. */
  readonly body: <%= e.model %> | undefined;
<% for (const f of e.fields) { -%>
  readonly <%= f.key %>: <%= f.type %> | undefined;
<% } -%>
<% } else { -%>
  /** The decoded response body, if any. */
  readonly body: unknown;
<% } -%>

  constructor(status: number, body: <%= e.model ? e.model + " | undefined" : "unknown" %>) {
    super(<%~ e.message %>);
    this.name = <%~ it.h.str(e.name) %>;
    this.status = status;
    this.body = body;
<% for (const f of e.fields) { -%>
    this.<%= f.key %> = body?.<%= f.key %>;
<% } -%>
  }
<% if (it.features["error-getters"]) { -%>

  get isUnauthorized(): boolean {
    return this.status === 401;
  }

  get isForbidden(): boolean {
    return this.status === 403;
  }

  get isNotFound(): boolean {
    return this.status === 404;
  }

  get isConflict(): boolean {
    return this.status === 409;
  }
<% } -%>
}
<% for (const c of it.clients) { -%>
<% if (c.auth) { -%>

/** Credential providers of the <%= c.auth.service %> API, by auth scheme id (`auth` in ClientOptions). */
export interface <%= c.auth.name %> {
<% for (const m of c.auth.members) { -%>
  /** <%~ m.docs %> */
  <%~ m.key %>?: <%~ m.type %>;
<% } -%>
}
<% } -%>

export class <%= c.name %> {
  private readonly baseUrl: string;
  private readonly doFetch: typeof fetch;
  private readonly headers: HeadersInput | undefined;
<% if (c.auth) { -%>
  private readonly auth: <%= c.auth.name %> | undefined;
<% } -%>

  constructor(options: ClientOptions<% if (c.auth) { %><<%= c.auth.name %>><% } %>) {
    this.baseUrl = options.baseUrl.replace(/\/$/, "");
    const doFetch: typeof fetch = options.fetch ?? ((input, init) => globalThis.fetch(input, init));
    const defaults = options.init;
    // Client-wide fetch options sit under each request's own.
    this.doFetch = defaults === undefined ? doFetch : (input, init) => doFetch(input, { ...defaults, ...init });
    this.headers = options.headers;
<% if (c.auth) { -%>
    this.auth = options.auth;
<% } -%>
  }
<% for (const g of c.groups) { -%>

<%~ it.h.banner(g.title, "  ") %>
<% for (const m of g.methods) { -%>

<%~ it.h.jsdoc(m.docs, "  ", m.deprecated) %><% if (m.stream) { -%>
  async *<%= m.name %>(<%~ m.params %>): <%~ m.returnType %> {
<% } else { -%>
  <% if (m.void || m.checks.length > 0 || m.decode) { %>async <% } %><%= m.name %>(<%~ m.params %>): Promise<<%~ m.returnType %>> {
<% } -%>
<% for (const check of m.checks) { -%>
    <%~ check %>
<% } -%>
<% if (m.stream) { -%>
    const response = await this.request(<%~ m.args %>);
<% if (m.stream.decode) { -%>
    for await (const event of decodeEvents(response.body, <%~ m.stream.events %>)) yield <%~ m.stream.decode %>.parse(event);
<% } else { -%>
    yield* decodeEvents(response.body, <%~ m.stream.events %>) as AsyncIterable<<%~ m.stream.element %>>;
<% } -%>
<% } else if (m.void) { -%>
    await this.request(<%~ m.args %>);
<% } else if (m.decode) { -%>
    return <%~ m.decode %>.parse(await this.send(<%~ m.args %>));
<% } else { -%>
    return this.send(<%~ m.args %>);
<% } -%>
  }
<% } -%>
<% } -%>
<% if (c.usesSend) { -%>

<% if (c.auth) { -%>
  private async send<T>(method: string, path: string, body?: unknown, init?: RequestOptions, auth?: readonly (readonly AuthScheme[])[]): Promise<T> {
    const response = await this.request(method, path, body, init, auth);
<% } else { -%>
  private async send<T>(method: string, path: string, body?: unknown, init?: RequestOptions): Promise<T> {
    const response = await this.request(method, path, body, init);
<% } -%>
    const text = await response.text();
    // An empty body (204 and the like) decodes to undefined.
    return (text ? JSON.parse(text) : undefined) as T;
  }
<% } -%>

<% const callOptions = it.usesStreams ? "init: RequestOptions & { accept?: string } = {}" : "options: RequestOptions = {}"; -%>
<% if (c.auth) { -%>
  private async request(method: string, path: string, body?: unknown, <%~ callOptions %>, auth?: readonly (readonly AuthScheme[])[]): Promise<Response> {
<% } else { -%>
  private async request(method: string, path: string, body?: unknown, <%~ callOptions %>): Promise<Response> {
<% } -%>
<% if (it.usesStreams) { -%>
    const { accept, ...options } = init;
<% } -%>
    const headers = new globalThis.Headers(typeof this.headers === "function" ? await this.headers() : this.headers);
<% if (c.auth) { -%>
    // Credentials override the client's headers; per-call headers override credentials.
    const credentials = auth ? await resolveAuth(this.auth, auth) : undefined;
    for (const [name, value] of credentials?.headers ?? []) headers.set(name, value);
<% } -%>
    new globalThis.Headers(options.headers).forEach((value, name) => headers.set(name, value));
<% if (it.usesStreams) { -%>
    // A stream's Accept: text/event-stream, unless a header sets one.
    if (accept !== undefined && !headers.has("accept")) headers.set("accept", accept);
<% } -%>
<% if (it.usesUploads) { -%>
    const raw = body instanceof RawBody;
    const contentType = raw ? body.contentType : "application/json";
    // FormData has none: fetch writes multipart/form-data with its boundary.
    if (contentType === undefined) headers.delete("content-type");
    else if (body !== undefined) headers.set("content-type", contentType);
<% } else { -%>
    if (body !== undefined) headers.set("content-type", "application/json");
<% } -%>
<% if (c.auth) { -%>
    let url = `${this.baseUrl}${path}`;
    if (credentials && credentials.query.length > 0) {
      const index = url.indexOf("?");
      const search = new URLSearchParams(index < 0 ? "" : url.slice(index + 1));
      for (const [name, value] of credentials.query) search.set(name, value);
      url = `${index < 0 ? url : url.slice(0, index)}?${search.toString()}`;
    }
    if (credentials && credentials.cookies.length > 0) {
      const cookies = credentials.cookies.map(([name, value]) => `${name}=${encodeURIComponent(value)}`).join("; ");
      const existing = headers.get("cookie");
      headers.set("cookie", existing ? `${existing}; ${cookies}` : cookies);
    }
    const response = await this.doFetch(url, {
<% } else { -%>
    const response = await this.doFetch(`${this.baseUrl}${path}`, {
<% } -%>
      ...safeInit(options),
      method,
      headers,
      ...(body === undefined ? {} : { body: <%~ it.usesUploads ? "raw ? body.body : JSON.stringify(body)" : "JSON.stringify(body)" %> }),
    });
    if (!response.ok) throw await toError(response);
    return response;
  }
}
<% } -%>

<% if (it.usesUploads) { -%>
/** A request body sent as-is (multipart FormData or a file) instead of JSON; FormData gets no Content-Type. */
class RawBody {
  readonly body: BodyInit;
  readonly contentType: string | undefined;

  constructor(body: BodyInit, contentType?: string) {
    this.body = body;
    this.contentType = contentType;
  }
}

interface PartSpec {
  name: string;
  key?: string;
  kind: "file" | "text" | "json";
  multi: boolean;
  /** Declared content type: given to untyped blobs of a file part; a JSON part's (application/json when absent). */
  contentType?: string;
}

/**
 * FormData of a multipart request object: text parts as strings, JSON parts as blobs of their JSON content type, files
 * with their name (the part name for a plain Blob) and, when untyped, the part's declared content type; multi
 * parts append every item; absent parts are skipped.
 */
function toFormData(value: object, parts: readonly PartSpec[]): globalThis.FormData {
  const form = new globalThis.FormData();
  const record = value as Record<string, unknown>;
  for (const part of parts) {
    const raw = record[part.key ?? part.name];
    if (raw === undefined || raw === null) continue;
    for (const item of part.multi && Array.isArray(raw) ? raw : [raw]) {
      if (part.kind === "file") {
        const blob = item as globalThis.Blob;
        const name = typeof globalThis.File !== "undefined" && blob instanceof globalThis.File ? blob.name : part.name;
        form.append(part.name, blob.type === "" && part.contentType ? new globalThis.Blob([blob], { type: part.contentType }) : blob, name);
      } else if (part.kind === "json") {
        form.append(part.name, new globalThis.Blob([JSON.stringify(item)], { type: part.contentType ?? "application/json" }));
      } else {
        form.append(part.name, <%= it.usesDates ? "toText" : "String" %>(item));
      }
    }
  }
  return form;
}

<% } -%>
<% if (it.usesAuth) { -%>
<%~ include("ts-nextjs/auth", { exported: false }) %>
<% } -%>
<% if (it.usesStreams) { -%>
<%~ include("ts-nextjs/sse-runtime", { exported: false }) %>

<% } -%>
async function toError(response: Response): Promise<<%= e.name %>> {
  const body: unknown = await response.json().catch(() => undefined);
<% if (e.model) { -%>
<% if (e.decode) { -%>
  // A codec error body failing decode (e.g. an invalid Date) must not become undefined; fall back to the raw body.
  return new <%= e.name %>(response.status, isErrorBody(body) ? (() => { const r = <%= e.decode %>.safeParse(body); return r.success ? r.data : body; })() : undefined);
<% } else { -%>
  return new <%= e.name %>(response.status, isErrorBody(body) ? body : undefined);
<% } -%>
}

function isErrorBody(value: unknown): value is <%= e.model %> {
  if (typeof value !== "object" || value === null) return false;
  const record = value as Record<string, unknown>;
  return [<%~ e.required.map((k) => it.h.str(k)).join(", ") %>].every((key) => record[key] !== undefined);
}
<% } else { -%>
  return new <%= e.name %>(response.status, body);
}
<% } -%>
<% if (it.usesQuery && it.usesArrays) { -%>

/** Arrays are comma-joined into one value unless their key is listed in `explode` (then the key repeats). */
function toQuery(params: Record<string, unknown>, explode: readonly string[] = []): string {
  const search = new URLSearchParams();
  for (const [key, value] of Object.entries(params)) {
    if (value === undefined || value === null) continue;
    if (!Array.isArray(value)) search.append(key, <%= it.usesDates ? "toText" : "String" %>(value));
    else if (explode.includes(key)) for (const item of value) search.append(key, <%= it.usesDates ? "toText" : "String" %>(item));
    else search.append(key, value.map(<%= it.usesDates ? "toText" : "String" %>).join(","));
  }
  const rendered = search.toString();
  return rendered ? `?${rendered}` : "";
}
<% } else if (it.usesQuery) { -%>

function toQuery(params: Record<string, unknown>): string {
  const search = new URLSearchParams();
  for (const [key, value] of Object.entries(params)) {
    if (value === undefined || value === null) continue;
    for (const item of Array.isArray(value) ? value : [value]) search.append(key, <%= it.usesDates ? "toText" : "String" %>(item));
  }
  const rendered = search.toString();
  return rendered ? `?${rendered}` : "";
}
<% } -%>
<% if (it.usesWithoutUndefined) { -%>

<%~ include("ts-nextjs/without-undefined", { exported: false }) %>
<% } -%>
<% if (it.usesDates && (it.usesQuery || it.usesUploads)) { -%>

/** A query or form value as sent: dates as ISO-8601 strings. */
function toText(value: unknown): string {
  return value instanceof Date ? value.toISOString() : String(value);
}
<% } -%>
