<% const d = it.decl; -%>
<%~ it.h.jsdoc(d.docs, "", d.deprecated) %>export interface <%= d.name %> {
<% for (const p of d.properties) { -%>
<%~ it.h.jsdoc(p.docs, "  ", p.deprecated, p.defaultDoc) %>  <%= p.key %><%= p.optional ? "?" : "" %>: <%= p.type.text %>;
<% } -%>
}
<% if (it.zod) { -%>

export const <%= d.name %>Schema: z.ZodType<<%= d.name %>> = z.object({
<% for (const p of d.properties) { -%>
  <%= p.key %>: <%= p.type.schema %><%= p.optional ? ".optional()" : "" %>,
<% } -%>
});
<% } -%>