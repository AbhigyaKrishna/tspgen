<% const d = it.decl; const ext = d.extends.length > 0; const tps = d.typeParameters ?? []; const tp = tps.length ? "<" + tps.join(", ") + ">" : ""; const alias = d.declaration === "type"; -%>
<%~ it.h.jsdoc(d.docs, "", d.deprecated, undefined, d.jsdoc) %><% if (alias) { %>export type <%= d.name %><%= tp %> = <%= ext ? d.extends.map((e) => e.text).join(" & ") + " & " : "" %>{
<% } else { %>export interface <%= d.name %><%= tp %><%= ext ? " extends " + d.extends.map((e) => e.text).join(", ") : "" %> {
<% } -%>
<% for (const p of d.properties) { -%>
<%~ it.h.jsdoc(p.docs, "  ", p.deprecated, p.defaultDoc, p.jsdoc) %>  <%= p.readonly ? "readonly " : "" %><%= p.key %><%= p.optional ? "?" : "" %>: <%= p.type.text %>;
<% } -%>
<%= alias ? "};" : "}" %>
<% if (it.zod && tps.length) { -%>

export function <%= d.name %>Schema<%= tp %>(<%= tps.map((t) => t + "Schema: z.ZodType<" + t + ">").join(", ") %>): z.ZodType<<%= d.name %><%= tp %>> {
  return z.object({
<% for (const p of d.properties) { -%>
    <%= p.key %>: <%= p.type.schema %><%= p.optional ? ".exactOptional()" : "" %>,
<% } -%>
  })<%= ext ? ".loose()" : "" %> as unknown as z.ZodType<<%= d.name %><%= tp %>>;
}
<% } else if (it.zod) { -%>

export const <%= d.name %>Schema<%= ext ? "" : ": z.ZodType<" + d.name + ">" %> = z.object({
<% for (const p of d.properties) { -%>
  <%= p.key %>: <%= p.type.schema %><%= p.optional ? ".exactOptional()" : "" %>,
<% } -%>
})<%= ext ? ".loose() as unknown as z.ZodType<" + d.name + ">" : "" %>;
<% } -%>