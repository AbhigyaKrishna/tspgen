<% const d = it.decl; -%>
<%~ it.h.jsdoc(d.docs, "", d.deprecated, undefined, d.jsdoc) %><%~ it.h.enumType(d) %>
<% if (d.style === "union-const") { -%>

export const <%= d.name %> = {
<% for (const m of d.members) { -%>
<%~ it.h.jsdoc(m.docs, "  ") %>  <%= m.name %>: <%= it.h.literal(m.value) %>,
<% } -%>
} as const;
<% } -%>
<% if (it.zod) { -%>

export const <%= d.name %>Schema: z.ZodType<<%= d.name %>> = <%~ it.h.enumSchema(d) %>;
<% } -%>
