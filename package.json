{
  "name": "tspgen-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "benchmark:kotlin": "pnpm build && node scripts/benchmark-kotlin-client.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "docs:options": "pnpm -r build && node scripts/docs-options.mjs",
    "test": "pnpm -r build && vitest run",
    "e2e": "pnpm -r build && pnpm --filter tspgen-e2e-kotlin --filter tspgen-e2e-typescript --filter tspgen-e2e-go test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
