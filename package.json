{
  "name": "specgen-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r build && vitest run",
    "e2e": "pnpm -r build && pnpm --filter specgen-e2e-kotlin --filter specgen-e2e-typescript --filter specgen-e2e-house-style test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
